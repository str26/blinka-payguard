{
  "name": "blinka-payguard",
  "version": "0.1.0",
  "description": "Prototipo independiente para el reto Blinka de Hackathon 30X",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:services": "node --env-file=.env.local scripts/check-services.mjs",
    "test": "tsc -p tsconfig.tests.json && node --test tests/decisions.test.mjs",
    "test:invoices": "tsc -p tsconfig.invoices-tests.json && node --test tests/extraction.test.mjs",
    "list:gemini-models": "node --env-file=.env.local scripts/list-gemini-models.mjs",
    "test:review": "tsc -p tsconfig.invoices-tests.json && node --test tests/review.test.mjs"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
